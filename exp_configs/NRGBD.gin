# dataset
VGAGSConfigs.dataset_name = "NRGBD"
VGAGSConfigs.data_root_dir = "/hdd24T/sunxt/dataset/neural_rgbd"
VGAGSConfigs.scene_name = "thin_geometry"
VGAGSConfigs.init_points_file = "fused.ply"
VGAGSConfigs.resize_factor = 1

# exp
VGAGSConfigs.output_root_dir = "outs"
